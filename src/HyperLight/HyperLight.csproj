<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 窗口程序：双击时不弹黑色命令行窗口（托盘程序）；带命令运行时程序会自己连上命令行窗口 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- 托盘图标和菜单用 Windows 自带的 WinForms，同时也带上了图形库 System.Drawing -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HyperLight</RootNamespace>
    <AssemblyName>HyperLight</AssemblyName>
    <!-- 程序图标：exe 文件、桌面快捷方式、任务栏上显示的图标（托盘里的小圆点是程序运行时另外画的，显示当前颜色） -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 编译警告一律当成错误，逼代码保持干净 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 只出 64 位 Windows 版本 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 允许在非 Windows 电脑上编译（云端检查用），不影响在 Windows 上运行 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 允许极少量的 unsafe 代码：截壁纸时直接读 Windows 分配的像素内存，不复制 30 多 MB -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 打包设置：自带运行库的单个 exe（对方电脑不用装 .NET） -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 不压缩：压缩的话运行时要把程序解压到内存里，多占几十 MB。不压缩 exe 文件会大一些，但只占硬盘 -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- 关掉后台垃圾回收：这个小程序用不着，省一个后台线程和它的内存 -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!--
      给托管内存定上限 64 MB（实际只用几 MB）。
      不设的话，.NET 会按 CPU 缓存大小决定"攒多少垃圾才清理一次"；
      7950X3D 这类大缓存 CPU 会攒到四五十 MB，任务管理器里的内存就从 20 MB 慢慢涨到 60 MB。
      设了上限，垃圾回收会勤快地清理，内存保持在低位。截图用的内存不算在这里面。
    -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="67108864" />
  </ItemGroup>

  <ItemGroup>
    <!-- HidSharp：USB HID 设备通信库，Apache-2.0 许可 -->
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

</Project>
